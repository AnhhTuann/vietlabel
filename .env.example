# Database (PostgreSQL / Docker / Neon)
# Generate a database password with: openssl rand -hex 32
# Docker Compose overrides the host in DATABASE_URL for the app container.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Local development outside Docker:
# Neon / Supabase: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgres://vietlabel:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/vietlabel

# Security
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Set these when creating the first admin or rotating unchanged demo credentials.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# AI Advisor & LLM API
# rules = no external API calls or token charges; gemini = enable quota-based/paid Gemini API
AI_PROVIDER=rules
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Contact & Channels
VITE_HOTLINE=0868968089
VITE_ZALO_OA_ID=0868968089
VITE_ZALO_URL=https://zalo.me/0868968089
VITE_FB_PAGE_USERNAME=vietlabel.vn
VITE_MESSENGER_URL=https://m.me/vietlabel.vn

# CRM & Sales Webhooks (Telegram, Zalo, Google Sheets, Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ESCALATION_MINUTES=10
WORKING_HOURS="08:00 - 17:30"
SALES_EMAILS=thien@vietlabel.com.vn,baogia@vietlabel.com.vn

# Zalo Staff Notifications (Optional, toggle with ZALO_ENABLED)
ZALO_ENABLED=false
ZALO_OA_ACCESS_TOKEN=
ZALO_STAFF_USER_IDS=

# Webhook Tokens
