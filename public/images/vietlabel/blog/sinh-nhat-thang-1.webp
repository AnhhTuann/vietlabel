:not(.transparent) .header-nav-main.nav > li > a.active,.header:not(.transparent) .header-nav-main.nav > li > a.current{color: #1e73be;}.header-nav-main.nav-line-bottom > li > a:before,.header-nav-main.nav-line-grow > li > a:before,.header-nav-main.nav-line > li > a:before,.header-nav-main.nav-box > li > a:hover,.header-nav-main.nav-box > li.active > a,.header-nav-main.nav-pills > li > a:hover,.header-nav-main.nav-pills > li.active > a{color:#FFF!important;background-color: #1e73be;}.absolute-footer, html{background-color: #282828}.nav-vertical-fly-out > li + li {border-top-width: 1px; border-top-style: solid;}/* Custom CSS */blockquote {/* margin: 20px 0; *//*   padding: 20px 30px !important; */margin-top: 30px !important;margin-bottom: 30px !important;padding-top: 30px !important;padding-bottom: 30px !important;background-color: #f0f5fa;border-left: 5px solid #004693 !important;position: relative;}blockquote p {color: #333;font-size: 1.1rem;line-height: 1.6;font-style: italic;margin: 0;}blockquote p::before, blockquote p::after {content: "" !important;}blockquote::before {content: "\201C"; /* Dấu nháy kép */font-family: Georgia, serif;color: rgba(0, 70, 147, 0.1);font-size: 80px;position: absolute;top: -10px;left: 10px;}/* ========================================================================== 7. TẦM NHÌN - SỨ MỆNH & GIÁ TRỊ CỐT LÕI (FULL WIDTH) ========================================================================== */.vvm-section-final {width: 100%;background: #f9f9f9;padding: 50px 0; /* Bỏ padding 2 bên của section để sát lề */box-sizing: border-box;font-family: Arial, sans-serif;}.vvm-header-final {text-align: center;color: #1a528e;font-size: 32px;font-weight: bold;margin-bottom: 40px;text-transform: uppercase;padding: 0 20px;}/* Lưới chứa Tầm nhìn & Sứ mệnh - Đổi sang full width */.vvm-grid-top {display: grid;grid-template-columns: 1fr 1fr;gap: 30px;width: 100%; /* Bung full 100% */max-width: 100%; /* Bỏ giới hạn px */padding: 0 30px; /* Thêm chút padding để chữ không dính sát viền màn hình quá */margin: 0 auto 40px auto;box-sizing: border-box;}.vvm-card-final {background: white;padding: 40px 35px;border-radius: 15px;box-shadow: 0 5px 20px rgba(0,0,0,0.06);border-top: 5px solid;}.vvm-card-final.card-orange { border-top-color: #d97706; }.vvm-card-final.card-blue { border-top-color: #1a528e; }.vvm-card-title {font-size: 24px;font-weight: bold;margin-bottom: 15px;text-transform: uppercase;}.vvm-card-title.c-orange { color: #d97706; }.vvm-card-title.c-blue { color: #1a528e; }.vvm-card-desc {font-size: 16px;color: #444;line-height: 1.6;}/* Phần Giá trị cốt lõi - Đổi sang full width */.vvm-core-values {width: 100%; /* Bung full 100% */max-width: 100%; /* Bỏ giới hạn px */margin: 0 auto;background: white;padding: 40px 20px;border-radius: 0; /* Bỏ border-radius nếu muốn sát viền phẳng hoàn toàn */box-shadow: 0 5px 20px rgba(0,0,0,0.06);border-top: 5px solid #e53935;text-align: center;box-sizing: border-box;}.vvm-core-title {font-size: 26px;font-weight: bold;color: #e53935;margin-bottom: 30px;text-transform: uppercase;}.vvm-pinwheel-img {max-width: 500px; /* Giữ nguyên kích thước ảnh hoa để không bị quá to vỡ hình */margin: 0 auto;transition: transform 0.6s ease-in-out;}/* Hiệu ứng xoay nhẹ và phóng to khi rê chuột vào chong chóng */.vvm-pinwheel-img:hover {transform: scale(1.05) rotate(10deg); }.vvm-pinwheel-img img {width: 100%;height: auto;display: block;}/* Căn chỉnh cho điện thoại */@media (max-width: 768px) {.vvm-grid-top { grid-template-columns: 1fr; padding: 0 15px;}.vvm-pinwheel-img { max-width: 100%; }}/* Custom CSS Tablet */@media (max-width: 849px){.ld3-sec-5 .banner{background-size: 450px 650px;}}/* Custom CSS Mobile */@media (max-width: 549px){.ld3-sec-5 .banner{background-size: 0px 0px!important;}.cf-margin-top-50{margin-top:0px;}.cf-margin-top-2{margin-top:0px;}}.label-new.menu-item > a:after{content:"New";}.label-hot.menu-item > a:after{content:"Hot";}.label-sale.menu-item > a:after{content:"Sale";}.label-p